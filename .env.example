# --- Required ---
DATABASE_URL=postgresql://proxy:proxy@localhost:5432/proxy
AUTH_SECRET=            # >=32 random chars: `openssl rand -hex 32`
APP_BASE_URL=http://localhost:3000

# --- Live research (SerpApi) ---
SERPAPI_API_KEY=

# --- AI extraction / synthesis (optional; deterministic extraction works without it) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Outbound RFQ email (optional; .eml export works without it) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=      # must be a sender verified in Resend, e.g. "Procurement <rfq@yourdomain.com>"

# --- Optional tuning ---
# SERPAPI_CACHE_TTL_HOURS=24
# SERPAPI_REQUESTS_PER_MINUTE=60
# RESEARCH_MAX_SUPPLIERS=25
# OPENAI_INPUT_PRICE_PER_MTOK=      # USD; enables cost-per-task in benchmarks
# OPENAI_OUTPUT_PRICE_PER_MTOK=
# SERPAPI_PRICE_PER_SEARCH=         # USD; enables search cost in benchmarks
